global proc int heat_vel_map_aggregate(string $vel_error_display_mesh, string $pos_error_display_mesh, int $startFrame, int $audioLength, float $color_max_vel, float $color_max_disp, int $one_if_output_mesh ) {
    // initialize
    int $mouth_vertices[] = vertices();
    string $python_vertices_input= "[359, 360, 361, 362, 363, 364, 365, 366, 367, 380, 391, 392, 393, 394, 395, 396, 397, 398, 399, 400, 401, 402, 417, 458, 459, 460, 461, 510, 511, 558, 559, 560, 561, 576, 577, 579, 580, 584, 585, 586, 587, 588, 589, 590, 591, 594, 595, 596, 597, 598, 599, 600, 601, 602, 603, 604, 605, 606, 607, 608, 609, 610, 611, 612, 613, 622, 623, 624, 625, 626, 627, 628, 629, 746, 771, 772, 773, 774, 795, 796, 797, 798, 938, 939, 963, 964, 965, 966, 967, 968, 990, 991, 992, 993, 994, 995, 996, 1106, 1107, 1110, 1111, 1112, 1113, 1114, 1115, 1116, 1117, 1124, 1125, 1127, 1128, 1129, 1130, 1131, 1132, 1133, 1134, 1135, 1136, 1137, 1154, 1157, 1158, 1159, 1160, 1161, 1162, 1163, 1164, 1166, 1167, 1170, 1172, 1174, 1176, 1177, 1178, 1179, 1180, 1181, 1182, 1183, 1184, 1185, 1190, 1201, 1202, 1203, 1204, 1205, 1206, 1207, 1209, 1210, 1211, 1212, 1213, 1214, 1215, 1216, 1217, 1218, 1219, 1220, 1221, 1222, 1223, 1224, 1225, 1226, 1227, 1228, 1229, 1230, 1231, 1232, 1233, 1267, 1268, 1269, 1270, 1338, 1339, 1340, 1341, 1342, 1343, 1344, 1345, 1346, 1347, 1348, 1349, 1350, 1351, 1386, 1387, 1388, 1389, 1390, 1391, 1430, 1431, 1435, 1436, 1437, 1438, 1439, 1440, 1558, 1559, 1560, 1561, 1562, 1563, 1564, 1565, 1566, 1567, 1568, 1569, 1570, 1571, 1572, 1573, 1574, 1575, 1939, 1940, 1941, 1942, 1943, 1944, 1945, 2062, 2064, 2073, 2103, 2104, 2105, 2106, 2107, 2108, 2109, 2110, 2136, 2137, 2138, 2139, 2140, 2144, 2145, 2146, 2147, 2148, 2149, 2150, 2151, 2152, 2153, 2154, 2155, 2156, 2157, 2158, 2160, 2161, 2475, 2476, 2481, 2482, 2483, 2935, 2936, 2937, 2938, 2987, 2988, 3035, 3036, 3037, 3038, 3053, 3054, 3061, 3062, 3063, 3064, 3065, 3066, 3067, 3068, 3071, 3072, 3073, 3074, 3075, 3076, 3077, 3078, 3079, 3080, 3081, 3082, 3083, 3084, 3085, 3086, 3087, 3088, 3089, 3090, 3099, 3100, 3101, 3102, 3103, 3104, 3105, 3106, 3248, 3249, 3250, 3251, 3272, 3273, 3274, 3275, 3415, 3416, 3440, 3441, 3442, 3443, 3444, 3445, 3467, 3468, 3469, 3470, 3471, 3472, 3473, 3583, 3584, 3587, 3588, 3589, 3590, 3591, 3592, 3593, 3594, 3601, 3602, 3603, 3604, 3605, 3606, 3607, 3608, 3609, 3610, 3611, 3612, 3613, 3614, 3631, 3634, 3635, 3636, 3637, 3638, 3639, 3643, 3644, 3647, 3649, 3651, 3653, 3654, 3655, 3656, 3659, 3660, 3661, 3662, 3667, 3678, 3679, 3680, 3681, 3682, 3683, 3684, 3685, 3689, 3690, 3691, 3692, 3693, 3694, 3695, 3696, 3697, 3698, 3699, 3700, 3701, 3702, 3705, 3706, 3707, 3708, 3709, 3710, 3744, 3745, 3746, 3747, 3815, 3816, 3818, 3819, 3820, 3821, 3822, 3823, 3824, 3825, 3826, 3827, 3828, 3863, 3864, 3865, 3866, 3867, 3868, 3907, 3908, 3912, 3913, 3914, 3915, 3916, 3917, 4035, 4036, 4037, 4038, 4039, 4040, 4041, 4042, 4043, 4044, 4045, 4046, 4047, 4048, 4049, 4050, 4051, 4052, 4416, 4417, 4418, 4419, 4420, 4421, 4422, 4541, 4546, 4550, 4580, 4581, 4582, 4583, 4584, 4585, 4586, 4587, 4613, 4614, 4615, 4616, 4617, 4621, 4622, 4623, 4624, 4625, 4626, 4627, 4628, 4629, 4630, 4631, 4632, 4633, 4634, 4635, 4637, 4638, 4934, 4935, 4940, 4941, 4942]";
    
    float $hue = 0;
    float $saturation = 0;
    float $value = 1;
    
    float $red = 0;
    float $green = 0;
    float $blue = 0;
    
    // int $startFrame = 90;
    // int $audioLength = 166;
    int $interval = 1;
    
    int $startVertex = 0;
    int $i = 0; 	// frame counter
    int $j = 0;	 //testhead counter
    int $k = 0; 	 // vertex counter
    
    // number of vertices to compare
    int $NumOfVertices[] = `polyEvaluate -vertex head_lorez`;
    $numOfVertices[0] = 510;

    float $magDispErr = 0;
    float $magDispErrMax = 0;
    matrix $magDispErrAgg[4][6000];
    float $magDispErrAggMax = 0;
    
    matrix $obj1PrevX[4][6000];
    matrix $obj1PrevY[4][6000];
    matrix $obj1PrevZ[4][6000];
    
    matrix $obj2PrevX[4][6000];
    matrix $obj2PrevY[4][6000];
    matrix $obj2PrevZ[4][6000];
    
    float $magVelErr = 0;
    float $magVelErrMax = 0;
    matrix $magVelErrAgg[4][1000];
    float $magVelErrAggMax = 0;
    
    vector $obj1 ;
    vector $obj2 ;
    vector $obj1Prev ;
    vector $obj2Prev ;
    vector $obj1Vel ;
    vector $obj2Vel ;
    
    //initialize aggregate magnitude matrix (don't know if there's a better way to do this)
    for ($j = 0; $j < 3; $j++){
    	for ($k = $startVertex; $k < $numOfVertices[0]; $k++) {
    		$magDispErrAgg[$j][$k] = 0.0;
    		$magVelErrAgg[$j][$k] = 0.0;
    	}
    }
    
    select head_lorez mocap_head_lorez;
    string $facepaint_original[] = `ls -sl`;
    
    // create strings based on (per-frame) disp error head names
    select Jali_error_disp mocap_head_lorez;
    string $facepaint[] = `ls -sl`;
    
    //create strings based on (aggregate) disp error head names
    select Jali_error_disp mocap_head_lorez;
    string $facepaintAgg[] = `ls -sl`;
    
    // create strings based on (per-frame) vel error head names
    select Jali_error_disp mocap_head_lorez;
    string $facepaintVel[] = `ls -sl`;
    
    //create strings based on (aggregate) vel error head names
    select Jali_error_disp mocap_head_lorez;
    string $facepaintVelAgg[] = `ls -sl`;
    
    //create strings based on CTL_Body nodes to calculate head x translation
    select Control_GRP pasted__Control_GRP;
    string $facetranslate[] = `ls -sl`;
    int $numRigs = 1;
    
    
    currentTime $startFrame ;
    
    // Calculate maximum error ($magDispErrMax) and per-vertex aggregate error ($magDispErrAggMax)
    // to normalize the heatmaps
    
    for ($i = $startFrame; $i < $audioLength; $i+=$interval) {
    	currentTime $i;
    	// print ("current time is   " + $i + "\n");
    	for ($j = 0; $j < $numRigs; $j++){
    		float $shift1 = `getAttr($facetranslate[$j] + ".tx")`;
    		float $shift2 = `getAttr($facetranslate[$numRigs] + ".tx")`;
            
       	 	for ($k = $startVertex; $k < $numOfVertices[0]; $k++) {
    			string $facepointposition1 =  ($facepaint_original[$j] + ".vtx[" + $mouth_vertices[$k] + "]");
    			string $facepointposition2 =  ($facepaint_original[$numRigs] + ".vtx[" + $mouth_vertices[$k] + "]");
    			$obj1=`pointPosition -l $facepointposition1`;
            	$obj2=`pointPosition -l $facepointposition2`;
    			
    			//calculate displacement errors
    			$obj1 = <<$obj1.x - $shift1, $obj1.y, $obj1.z>>;
    			$obj2 = <<$obj2.x - $shift2, $obj2.y, $obj2.z>>;
    			
        		$magDispErr= mag($obj2 - $obj1);
    			$magDispErrMax = max($magDispErr,$magDispErrMax);
    			$magDispErrAgg[$j][$k] = ($magDispErrAgg[$j][$k] + $magDispErr);	
    
    			//calculate velocity errors
    			if ($i > $startFrame) {
    					$obj1Prev = <<$obj1PrevX[$j][$k], $obj1PrevY[$j][$k], $obj1PrevZ[$j][$k]>>;
    					$obj2Prev = <<$obj2PrevX[$j][$k], $obj2PrevY[$j][$k], $obj2PrevZ[$j][$k]>>;
    					
    					
    					
    					$obj1Vel = $obj1 - $obj1Prev;
    					$obj2Vel = $obj2 - $obj2Prev;
    					
    					
    					
    					$magVelErr = mag($obj2Vel - $obj1Vel);
    					$magVelErrMax = max($magVelErr, $magVelErrMax);
    					$magVelErrAgg[$j][$k] = ($magVelErrAgg[$j][$k] + $magVelErr);
    				}
    
    			
    			$obj1PrevX[$j][$k] = $obj1.x;
    			$obj1PrevY[$j][$k] = $obj1.y;
    			$obj1PrevZ[$j][$k] = $obj1.z;
    
    			$obj2PrevX[$j][$k] = $obj2.x;
    			$obj2PrevY[$j][$k] = $obj2.y;
    			$obj2PrevZ[$j][$k] = $obj2.z;
    			
    		}  	
    	}
    }
    
    // Calculate the maximum aggregate error from all 3 characters
    for ($j = 0; $j < $numRigs; $j++){
    	for ($k = $startVertex; $k < $numOfVertices[0]; $k++) {
    		$magDispErrAggMax = max($magDispErrAggMax, $magDispErrAgg[$j][$k]);
    		$magVelErrAggMax = max($magVelErrAggMax, $magVelErrAgg[$j][$k]);
    	}
    }
    print ("Max Magnitude:   " + $magDispErrMax +"\n");
    print ("Max Aggregate:  " + $magDispErrAggMax + "\n");
    print ("Max Vel Magnitude:   " + $magVelErrMax +"\n");
    print ("Max Vel Aggregate:  " + $magVelErrAggMax + "\n");
    if ($one_if_output_mesh == 0){
        return 1;
    }
    // Calculate the heatmaps for per-frame error magnitude (top row of heads) 
    //and aggregate error magnitude (bottom row)
    
    // for ($i = $startFrame; $i < $audioLength; $i+=$interval) {
	for ($j = 0; $j < $numRigs; $j++){
		// print ("current face: " + $facepaint [$j] + "\n");

		//calculate x translation of each head to subtract x offset
		float $shift1 = `getAttr($facetranslate[$j] + ".tx")`;
		float $shift2 = `getAttr($facetranslate[$numRigs] + ".tx")`;
		
		string $vel_colors = "[";
		string $disp_colors = "[";
		
		for ($k = $startVertex; $k < $numOfVertices[0]; $k++) {
		    // print($k);
			// print("\n");
			string $facepointposition1 =  ($facepaint_original[$j] + ".vtx[" + $mouth_vertices[$k] + "]");
			string $facepointposition2 =  ($facepaint_original[$numRigs] + ".vtx[" + $mouth_vertices[$k] + "]");
			// string $facepointpositionAgg =  ($facepaintAgg[$j] + ".vtx[" + $mouth_vertices[$k] + "]");
			// string $facepointVel =  ($facepaintVel[$j] + ".vtx[" + $mouth_vertices[$k] + "]");
			// string $facepointVelAgg =  ($facepaintVelAgg[$j] + ".vtx[" + $mouth_vertices[$k] + "]");
			
			$obj1=`pointPosition -l $facepointposition1`;
        	$obj2=`pointPosition -l $facepointposition2`;
			
			//subtract the offset from each head
			$obj1 = <<$obj1.x - $shift1, $obj1.y, $obj1.z>>;
			$obj2 = <<$obj2.x - $shift2, $obj2.y, $obj2.z>>;
			
    		$magDispErr= mag($obj2-$obj1);
			$magDispErrAgg[$j][$k] = ($magDispErrAgg[$j][$k] + $magDispErr);				
			
			//COLOR DISPLACEMENT ERROR
			
			if ($color_max_disp == 0){
    	    	$hue = (1.0 - ( $magDispErrAgg[$j][$k]  / $magDispErrAggMax));
    			$saturation = ( $magDispErrAgg[$j][$k]  / $magDispErrAggMax);
    	    } else {
    	        $hue = (1.0 - ( $magDispErrAgg[$j][$k]  / $color_max_disp));
    			$saturation = ( $magDispErrAgg[$j][$k]  / $color_max_disp);
    	    }

			//convert hsv to rgb for aggregate error 
			$rgb = `hsv_to_rgb  << $hue, $saturation, $value >>`;
			$red = $rgb.x;
			$green = $rgb.y;
			$blue = $rgb.z;

			//color in the vertex for aggregate error
			//polyColorPerVertex -rgb $red $green $blue  $facepointpositionAgg;
            if ($k == $numOfVertices[0]-1){
			    $disp_colors = $disp_colors  + "(" + $red + ", " + $green  + ", "+ $blue  + ", "+ "1)]";
			} else {
			    $disp_colors  = $disp_colors  + "(" + $red + ", " + $green  + ", "+ $blue  + ", "+ "1),";
			}
            //COLOR VELOCITY AGGREGATE ERROR
			//calculate hue and saturation for aggregate error heatmap
			// print($magVelErrAggMax);
			if ($color_max_vel == 0){
    			$hue = (1.0 - ( $magVelErrAgg[$j][$k]  / $magVelErrAggMax));
    			$saturation = ( $magVelErrAgg[$j][$k]  / $magVelErrAggMax);
    	    } else {
    	        $hue = (1.0 - ( $magVelErrAgg[$j][$k]  / $color_max_vel));
    			$saturation = ( $magVelErrAgg[$j][$k]  / $color_max_vel);
    	    }
			//convert hsv to rgb for aggregate error 
			$rgb = `hsv_to_rgb  << $hue, $saturation, $value >>`;
			$red = $rgb.x;
			$green = $rgb.y;
			$blue = $rgb.z;
			//color in the vertex for aggregate error
			if ($k == $numOfVertices[0]-1){
			    $vel_colors = $vel_colors  + "(" + $red + ", " + $green  + ", "+ $blue  + ", "+ "1)]";
			} else {
			    $vel_colors  = $vel_colors  + "(" + $red + ", " + $green  + ", "+ $blue  + ", "+ "1),";
			}
			//color in the vertex for per-frame error
			// polyColorPerVertex -rgb  $red $green $blue $facepointposition1;    				
			$obj1PrevX[$j][$k] = $obj1.x;
			$obj1PrevY[$j][$k] = $obj1.y;
			$obj1PrevZ[$j][$k] = $obj1.z;

			$obj2PrevX[$j][$k] = $obj2.x;
			$obj2PrevY[$j][$k] = $obj2.y;
			$obj2PrevZ[$j][$k] = $obj2.z;
		}
		// print($vel_colors);
		python("apply_api_colors(" + $vel_colors + ", " + $python_vertices_input + "," + $vel_error_display_mesh + ")");
		python("apply_api_colors(" + $disp_colors + ", " + $python_vertices_input + "," + $pos_error_display_mesh + ")");
		// python("only_show_mouth(" + $vel_error_display_mesh + ", " + $python_vertices_input + ")"); 
	}   
	return 1;
}
